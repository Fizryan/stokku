# ============================================================================
# Stokku — Konfigurasi Environment
# Salin file ini menjadi `.env` jika ingin menyesuaikan nilai default lokal.
# ============================================================================

# Mode eksekusi: development | test | production
NODE_ENV=development

# Host & Port HTTP Server
HOST=0.0.0.0
PORT=3000

# Lokasi file database SQLite (mode WAL otomatis diaktifkan)
DATABASE_PATH=./data/stokku.sqlite

# Masa berlaku sesi login dalam jam (1 - 720)
SESSION_TTL_HOURS=24

# Kebijakan atribut Secure pada cookie sesi:
# - auto  : aktif otomatis bila koneksi HTTPS atau X-Forwarded-Proto=https (aman untuk HTTP lokal/LAN & reverse proxy HTTPS)
# - true  : paksa hanya dikirim melalui HTTPS
# - false : nonaktifkan atribut Secure
COOKIE_SECURE=auto

# Daftar Origin tambahan yang diizinkan untuk proteksi CSRF (pisahkan dengan koma jika ada)
CORS_ORIGINS=

